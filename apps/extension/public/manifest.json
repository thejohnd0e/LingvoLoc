{
  "manifest_version": 3,
  "name": "LingvoLoc",
  "version": "3.1.3",
  "description": "Translate selected text through your local LingvoLoc desktop app.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:47831/*"],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/selectionTracker.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Translate with LingvoLoc",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
