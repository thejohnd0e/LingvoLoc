{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LingvoLoc",
  "version": "3.1.1",
  "identifier": "com.lingoloc.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LingvoLoc",
        "width": 1180,
        "height": 820,
        "resizable": true,
        "minWidth": 320,
        "minHeight": 600
      },
      {
        "label": "popup",
        "title": "LingvoLoc Clipboard",
        "width": 460,
        "height": 360,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 240,
        "skipTaskbar": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"],
    "resources": {
      "resources/pdfium/": "pdfium/",
      "resources/fonts/OFL.txt": "fonts/OFL.txt",
      "resources/fonts/SOURCE.md": "fonts/SOURCE.md"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
